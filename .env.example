# PIP environment. Copy to `.env` and fill in.
#
# `.env` is git-ignored. Nothing in this file is a secret: every value here is
# blank on purpose. Every variable is read through `pons_pip.config.load_settings`
# at call time, never at import time, and validated with pydantic before use.

# --- execution (blank = UNARMED / paper) -----------------------------------
PONS_PIP_TRADING_KEY=                 # EVM key for the dedicated budget wallet; must derive PONS_PIP_BUDGET_ADDRESS or the agent aborts. Never commit, never log.
PONS_PIP_BUDGET_ADDRESS=              # published budget-wallet address
PONS_PIP_MODE=paper                   # paper | live (default paper)

# --- Robinhood Chain -------------------------------------------------------
RHC_RPC_HTTP=https://rpc.mainnet.chain.robinhood.com   # TODO(pons): confirm on ponsfamily.com/docs; use a dedicated RPC in prod
RHC_RPC_WS=                            # optional live feed
RHC_CHAIN_ID=4663                      # 46630 testnet - TODO(pons): confirm
PONS_ROUTER_ADDRESS=                   # TODO(pons): Pons V2 / Uniswap V4 router
CHAINLINK_FEED_REGISTRY=               # TODO(pons): stock price feeds

# --- data + agent ----------------------------------------------------------
STOCK_DATA_API_KEY=                    # equities market data provider
STOCK_DATA_API_BASE=                   # https base URL of the provider; must be on the outbound allowlist
PONS_PIP_MODEL_API_KEY=                # model access for the think/sentiment stage
PONS_PIP_CYCLE_SECRET=                 # gates MCP run_cycle / privileged actions
PONS_PIP_WEBHOOK_URL=                  # optional per-trade notifications (SSRF-guarded, https only)
PONS_PIP_MCP_HOST=127.0.0.1            # MCP bind address; keep on loopback unless fronted by an authenticating proxy
PONS_PIP_MCP_PORT=8765
PONS_PIP_METRICS_HOST=127.0.0.1        # Prometheus bind address
PONS_PIP_METRICS_PORT=8000

# --- infra -----------------------------------------------------------------
REDIS_URL=                             # optional; in-memory cache if empty
DATABASE_URL=sqlite:///data/pons_pip.db
